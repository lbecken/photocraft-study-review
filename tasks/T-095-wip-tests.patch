@@ -0,0 +1,141 @@
+//! T-095 AC-D1 to AC-D3 (ruling 4, D-272; Q-B, D-275): the document statements this task adds,
+//! read from the repository's files. Written by the test author from
+//! `tasks/T-095-windows-path-names-and-case.md` alone (Pinned (i)).
+//!
+//! Each document is read from `CARGO_MANIFEST_DIR/../../docs/…` and its whitespace squashed (every
+//! run of whitespace becomes one space), so line wrapping and CRLF on a Windows checkout read the
+//! same. No platform cfg: these run, and fail on base, on every platform. Every test in this file
+//! fails on base (the join refuses a file of acceptance tests in which one passes on base); what
+//! the task keeps unchanged is the reviewer's diff check or a guard, not tested here.
+//!
+//! The sentences are pinned as Pinned (i) words them ("worded to be copied"); each test collects
+//! every mismatch before it fails, so one run names all of them.
+#![cfg(test)]
+
+use std::fs;
+use std::path::Path;
+
+/// The document at `rel` below `docs/`, whitespace squashed.
+fn doc(rel: &str) -> String {
+    let path = Path::new(env!("CARGO_MANIFEST_DIR"))
+        .join("../../docs")
+        .join(rel);
+    let text = fs::read_to_string(&path)
+        .unwrap_or_else(|e| panic!("read {}: {e}", path.display()));
+    squash(&text)
+}
+
+fn squash(s: &str) -> String {
+    s.split_whitespace().collect::<Vec<_>>().join(" ")
+}
+
+fn require(problems: &mut Vec<String>, file: &str, text: &str, wanted: &str) {
+    let wanted = squash(wanted);
+    if !text.contains(&wanted) {
+        problems.push(format!("{file} lacks: {wanted:?}"));
+    }
+}
+
+fn forbid(problems: &mut Vec<String>, file: &str, text: &str, unwanted: &str) {
+    let unwanted = squash(unwanted);
+    if text.contains(&unwanted) {
+        problems.push(format!("{file} still has: {unwanted:?}"));
+    }
+}
+
+fn finish(test: &str, problems: Vec<String>) {
+    assert!(
+        problems.is_empty(),
+        "{test}: {} problem(s):\n{}",
+        problems.len(),
+        problems.join("\n")
+    );
+}
+
+const PATHS: &str = "protocol/paths.md";
+const PROJECT: &str = "protocol/project.md";
+const CONTROL: &str = "control-protocol.md";
+
+/// Pinned (i) item 1: the Windows paragraph of "Lexical refusals".
+const LEXICAL_WINDOWS: &str = "On Windows (T-095) a path is also refused this way if it \
+contains `:`, `<`, `>`, `\"`, `|`, `?`, `*` or a control character (U+0001 to U+001F), the \
+characters Windows does not allow in a file name: so no request names an alternate data stream \
+(`f.txt::$DATA` is a second name of `f.txt` there) or another drive (`C:x`). On Linux and macOS \
+these characters are ordinary.";
+
+/// Pinned (i) item 2: reserved device names and trailing dots or spaces.
+const RESERVED_NAMES: &str = "Names that Windows reserves for devices (`CON`, `NUL`, `aux.rs`, …) \
+and names ending in a dot or a space are ordinary files of the project for Kiln, which reaches \
+every file through `\\\\?\\` paths. Other Windows programs may not open them (T-095; CI run \
+44290286460).";
+
+/// AC-D1: `paths.md` holds Pinned (i) item 1 as worded, under a heading that no longer says
+/// "(unchanged)" (the paragraph makes it false). Base: the paragraph is absent.
+#[test]
+fn acd1_paths_md_states_the_windows_lexical_refusals() {
+    let paths = doc(PATHS);
+    let mut problems = Vec::new();
+    require(&mut problems, PATHS, &paths, LEXICAL_WINDOWS);
+    forbid(&mut problems, PATHS, &paths, "## Lexical refusals (unchanged)");
+    require(&mut problems, PATHS, &paths, "## Lexical refusals");
+    finish("acd1", problems);
+}
+
+/// AC-D2: `paths.md` holds Pinned (i) item 2 as worded and no longer says that names or case on
+/// Windows are "not yet stated" (T-074's sentence nor T-093's "Platforms" clause). Base: item 2
+/// absent, both "not yet stated" sentences present.
+#[test]
+fn acd2_paths_md_states_reserved_and_trailing_names_and_drops_not_yet_stated() {
+    let paths = doc(PATHS);
+    let mut problems = Vec::new();
+    require(&mut problems, PATHS, &paths, RESERVED_NAMES);
+    forbid(
+        &mut problems,
+        PATHS,
+        &paths,
+        "Names that Windows gives a meaning, and case, are not yet stated for Windows (T-095).",
+    );
+    forbid(
+        &mut problems,
+        PATHS,
+        &paths,
+        "names and case on Windows are not yet stated (T-095)",
+    );
+    finish("acd2", problems);
+}
+
+/// AC-D3: the two D-270 citations name CI run 44358453526 and its record
+/// `tasks/ci-runs/T-074-round-1.md` (Pinned (i), last item), and the replaced citations are gone.
+/// Base: both cite 44307677646 / `T-074-early-1.md`. The variant to reject (run id changed, record
+/// left at `T-074-early-1.md`) fails the `require` lines, which hold run and record together.
+#[test]
+fn acd3_d270_citations_name_run_44358453526() {
+    let control = doc(CONTROL);
+    let project = doc(PROJECT);
+    let mut problems = Vec::new();
+    require(
+        &mut problems,
+        CONTROL,
+        &control,
+        "(shown in CI run 44358453526, `tasks/ci-runs/T-074-round-1.md`, for a junction",
+    );
+    forbid(
+        &mut problems,
+        CONTROL,
+        &control,
+        "(shown in CI run 44307677646, `tasks/ci-runs/T-074-early-1.md`, for a junction",
+    );
+    require(
+        &mut problems,
+        PROJECT,
+        &project,
+        "the `awa1_*` tests of `guard_t074.rs` in CI run 44358453526, `tasks/ci-runs/T-074-round-1.md`",
+    );
+    forbid(
+        &mut problems,
+        PROJECT,
+        &project,
+        "`guard_t074.rs` in CI run 44307677646, `tasks/ci-runs/T-074-early-1.md`;",
+    );
+    finish("acd3", problems);
+}
