+/// AC-W3, Interface (3) third bullet: two `Document`s, `f.txt` and `F.TXT`. On macOS and Windows
+/// they are two documents of one file and the second save wins (the file holds its bytes, one
+/// entry). On Linux they are two files, each holding its own document's save.
+#[test]
+fn two_documents_under_two_spellings_the_later_save_wins() {
+    let w = Work::new("two-docs");
+    w.file("f.txt", LOWER);
+    if CASE_SENSITIVE {
+        w.file("F.TXT", b"upper file\n");
+    }
+    let mut disk = w.disk();
+    let mut problems = Vec::new();
+    let lower = rp("f.txt");
+    let upper = rp("F.TXT");
+    match (Document::open(&disk, &lower), Document::open(&disk, &upper)) {
+        (Ok(mut first), Ok(mut second)) => {
+            first
+                .buffer_mut()
+                .insert(0, "one ")
+                .unwrap_or_else(|e| panic!("[{OS}] insert: {e:?}"));
+            second
+                .buffer_mut()
+                .insert(0, "two ")
+                .unwrap_or_else(|e| panic!("[{OS}] insert: {e:?}"));
+            same(
+                &mut problems,
+                "save f.txt",
+                label(&first.save(&mut disk).map(|_| ())),
+                "Ok(())".to_owned(),
+            );
+            same(
+                &mut problems,
+                "save F.TXT",
+                label(&second.save(&mut disk).map(|_| ())),
+                "Ok(())".to_owned(),
+            );
+            let entries = names(&w.dir);
+            measured(
+                "case two documents, entries after both saves",
+                &format!("{entries:?}"),
+            );
+            let one = format!("one {}", String::from_utf8_lossy(LOWER)).into_bytes();
+            if CASE_SENSITIVE {
+                same(
+                    &mut problems,
+                    "entries",
+                    entries,
+                    vec!["F.TXT".to_owned(), "f.txt".to_owned()],
+                );
+                same(
+                    &mut problems,
+                    "read f.txt",
+                    label(&disk.read(&lower)),
+                    label::<Vec<u8>>(&Ok(one)),
+                );
+                same(
+                    &mut problems,
+                    "read F.TXT",
+                    label(&disk.read(&upper)),
+                    label::<Vec<u8>>(&Ok(b"two upper file\n".to_vec())),
+                );
+            } else {
+                let two = format!("two {}", String::from_utf8_lossy(LOWER)).into_bytes();
+                same(&mut problems, "entry count", entries.len(), 1);
+                same(
+                    &mut problems,
+                    "read f.txt",
+                    label(&disk.read(&lower)),
+                    label::<Vec<u8>>(&Ok(two.clone())),
+                );
+                same(
+                    &mut problems,
+                    "read F.TXT",
+                    label(&disk.read(&upper)),
+                    label::<Vec<u8>>(&Ok(two)),
+                );
+            }
+        }
+        (a, b) => problems.push(format!("[{OS}] Document::open: f.txt {a:?}, F.TXT {b:?}")),
+    }
+    finish(
+        "two_documents_under_two_spellings_the_later_save_wins",
+        problems,
+    );
+}
+
+const LONG_DIR: &str = "averylongname";
+const LONG_BYTES: &[u8] = b"long g\n";
+const OTHER_BYTES: &[u8] = b"other file\n";
+
+/// The short name `cmd /c dir /x` shows for the entry `long` of `dir`, or `None`.
+fn short_name_of(dir: &Path, long: &str) -> Result<Option<String>, String> {
+    let mut cmd = Command::new("cmd");
+    cmd.arg("/C").arg("dir").arg("/X").arg(dir);
+    let out = run_output(cmd, "cmd /C dir /X")?;
+    for line in out.lines() {
+        let tokens: Vec<&str> = line.split_whitespace().collect();
+        if tokens.last() == Some(&long) && tokens.len() >= 2 {
+            let before = tokens[tokens.len() - 2];
+            return Ok((before != "<DIR>").then(|| before.to_owned()));
+        }
+    }
+    Err(format!("cmd /C dir /X: no line for {long:?} in {out:?}"))
+}
+
+/// The drive of `p` (`C:`), or `none`.
+fn drive_of(p: &Path) -> String {
+    match p.components().next() {
+        Some(Component::Prefix(prefix)) => prefix.as_os_str().to_string_lossy().into_owned(),
+        _ => "none".to_owned(),
+    }
+}
+
+/// AC-W3, Interface (5) fourth item, second half (measurement rule, Q-D): a read under an 8.3
+/// short name. On Windows the fixture (`averylongname/g.txt` and `other.txt`) is in
+/// `std::env::temp_dir()`; printed: that drive, its `fsutil 8dot3name query` output, the short
+/// name `cmd /c dir /x` shows (or `none`), and the read under the short name. Asserted: the read
+/// is `Ok(<g.txt's bytes>)` or `NotFound`, never another file's bytes or another kind, and the
+/// fixture is unchanged; it is removed on drop. On Linux and macOS the fixture is below
+/// `CARGO_TARGET_TMPDIR` and a read of `averyl~1/g.txt` is `NotFound`.
+#[test]
+fn short_name_read_reaches_the_long_file_or_nothing() {
+    let w = if cfg!(windows) {
+        Work::at_base(&std::env::temp_dir(), "kiln-guard-t095-short")
+    } else {
+        Work::new("short")
+    };
+    w.file(&format!("{LONG_DIR}/g.txt"), LONG_BYTES);
+    w.file("other.txt", OTHER_BYTES);
+    let before = snapshot(&w.dir);
+    let disk = w.disk();
+    let mut problems = Vec::new();
+    let bounded = |problems: &mut Vec<String>, what: &str, r: &Result<Vec<u8>, VfsError>| {
+        let fine = matches!(r, Err(VfsError::NotFound { .. }))
+            || matches!(r, Ok(b) if b.as_slice() == LONG_BYTES);
+        if !fine {
+            problems.push(format!(
+                "[{OS}] {what}: expected Ok(<g.txt's bytes>) or NotFound, got {}",
+                label(r)
+            ));
+        }
+    };
+    if cfg!(windows) {
+        let drive = drive_of(&std::env::temp_dir());
+        measured("short name temp_dir drive", &drive);
+        let mut fsutil = Command::new("fsutil");
+        fsutil.arg("8dot3name").arg("query").arg(&drive);
+        let state = match run_output(fsutil, "fsutil 8dot3name query") {
+            Ok(s) => s.split_whitespace().collect::<Vec<_>>().join(" "),
+            Err(e) => format!("query failed: {e}"),
+        };
+        measured("short name 8dot3name query", &state);
+        let short = short_name_of(&w.dir, LONG_DIR);
+        measured(
+            "short name of averylongname",
+            &match &short {
+                Ok(Some(s)) => s.clone(),
+                Ok(None) => "none".to_owned(),
+                Err(e) => format!("not read: {e}"),
+            },
+        );
+        match short {
+            Ok(Some(s)) => match RelPath::new(&format!("{s}/g.txt")) {
+                Ok(p) => {
+                    let r = disk.read(&p);
+                    measured("short name read", &format!("{s}/g.txt: {}", label(&r)));
+                    bounded(&mut problems, &format!("read {s}/g.txt"), &r);
+                }
+                Err(e) => problems.push(format!(
+                    "[{OS}] short name {s:?}: RelPath::new refused: {e:?}"
+                )),
+            },
+            Ok(None) => measured("short name read", "none"),
+            Err(e) => problems.push(format!("[{OS}] short name not read from the system: {e}")),
+        }
+        let guess = disk.read(&rp("averyl~1/g.txt"));
+        bounded(&mut problems, "read averyl~1/g.txt", &guess);
+    } else {
+        measured("short name temp_dir drive", "none");
+        measured("short name 8dot3name query", "none");
+        measured("short name of averylongname", "none");
+        let r = disk.read(&rp("averyl~1/g.txt"));
+        measured("short name read", &format!("averyl~1/g.txt: {}", label(&r)));
+        same(
+            &mut problems,
+            "read averyl~1/g.txt",
+            label(&r),
+            "NotFound".to_owned(),
+        );
+    }
+    same(
+        &mut problems,
+        "fixture after the reads",
+        snapshot(&w.dir),
+        before,
+    );
+    finish("short_name_read_reaches_the_long_file_or_nothing", problems);
+}
