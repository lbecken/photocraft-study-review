@@ -0,0 +1,962 @@
+//! T-095 Interface (5), test author: the Windows lexical refusals of Interface (1), the names of
+//! Interface (2) that stay ordinary files, the case and short-name limits of Interface (3), and
+//! Windows' own answer for each refused character (Q-E, D-275), through the Rust API of
+//! `kiln-workspace` (`RelPath`, `DiskFs`, `MemoryFs`, `Vfs`, `Document`). Written by the test
+//! author from `tasks/T-095-windows-path-names-and-case.md` alone.
+//!
+//! Guards: on Linux and macOS every test asserts behaviour the task keeps unchanged, so they pass
+//! on base there. On Windows the refusal tests are the runtime evidence of AC-W1 (they fail on
+//! Windows at base by design; fail-on-base there is the probe record
+//! `tasks/ci-runs/T-074-probe-1.md`, letter I), the reserved-name test of AC-W2 and the case and
+//! short-name tests of AC-W3; T-072's general reported step runs this file with
+//! `-- --show-output`.
+//!
+//! No platform cfg in this file (D-245). Every test runs on every platform; expectations are
+//! chosen at run time: the refusal rule of (1) by [`RULE_ON`] (`cfg!(windows)`), the case
+//! behaviour of (3) by `cfg!(target_os = "linux")` (macOS's default volume and Windows fold
+//! case; Interface (6), last paragraph). Measurements (ruling Q-D, D-275) print
+//! `MEASURED: <case>: <platform>: <value>` on the test's stdout and assert only the bounded
+//! outcomes the spec gives. No message text and no OS error number is asserted. Every spawned
+//! process has a timeout (60 s; D-028 (8)). Fixtures are fresh directories below
+//! `CARGO_TARGET_TMPDIR`, removed on drop, except the Windows short-name fixture, which is in
+//! `std::env::temp_dir()` (Interface (3)) and also removed on drop.
+#![cfg(test)]
+
+use std::collections::BTreeMap;
+use std::fs;
+use std::io;
+use std::path::{Component, Path, PathBuf};
+use std::process::{Command, Stdio};
+use std::time::{Duration, Instant};
+
+use kiln_workspace::{DiskFs, Document, MemoryFs, OpenError, RelPath, Vfs, VfsError};
+
+const OS: &str = std::env::consts::OS;
+const SPAWN_TIMEOUT: Duration = Duration::from_secs(60);
+
+/// Interface (1) holds on this platform: Windows only (ruling 1, D-272).
+const RULE_ON: bool = cfg!(windows);
+
+/// Interface (3): the platform keeps `F.TXT` and `f.txt` apart (Linux); macOS and Windows fold.
+const CASE_SENSITIVE: bool = cfg!(target_os = "linux");
+
+/// The characters Interface (1) adds, besides U+0001 to U+001F.
+const WINDOWS_PUNCTUATION: [char; 7] = [':', '<', '>', '"', '|', '?', '*'];
+
+/// Unicode look-alikes of refused characters, accepted on every platform (Interface (5)).
+const LOOK_ALIKES: [char; 6] = [
+    '\u{ff1a}', '\u{2236}', '\u{ff1f}', '\u{ff0a}', '\u{ff1c}', '\u{ff02}',
+];
+
+// ---------------------------------------------------------------------------------------------
+// Fixtures and helpers.
+
+/// A fresh directory for one test; removed on drop.
+struct Work {
+    dir: PathBuf,
+}
+
+impl Work {
+    fn new(name: &str) -> Work {
+        let base = Path::new(env!("CARGO_TARGET_TMPDIR")).join("guard_t095");
+        Work::at_base(&base, name)
+    }
+
+    fn at_base(base: &Path, name: &str) -> Work {
+        let dir = base.join(format!("{name}-{}", std::process::id()));
+        if fs::symlink_metadata(&dir).is_ok() {
+            fs::remove_dir_all(&dir).unwrap_or_else(|e| {
+                panic!("[{OS}] fixture: remove old {}: {}", dir.display(), os(&e))
+            });
+        }
+        fs::create_dir_all(&dir)
+            .unwrap_or_else(|e| panic!("[{OS}] fixture: create {}: {}", dir.display(), os(&e)));
+        Work { dir }
+    }
+
+    /// `rel` (`/`-separated) below the fixture.
+    fn at(&self, rel: &str) -> PathBuf {
+        rel.split('/').fold(self.dir.clone(), |p, s| p.join(s))
+    }
+
+    /// A file planted with `std::fs` (not through Kiln); only for names the host can store.
+    fn file(&self, rel: &str, bytes: &[u8]) {
+        let p = self.at(rel);
+        if let Some(parent) = p.parent() {
+            fs::create_dir_all(parent)
+                .unwrap_or_else(|e| panic!("[{OS}] fixture: create dir for {rel}: {}", os(&e)));
+        }
+        fs::write(&p, bytes).unwrap_or_else(|e| panic!("[{OS}] fixture: write {rel}: {}", os(&e)));
+    }
+
+    fn disk(&self) -> DiskFs {
+        DiskFs::new(&self.dir)
+            .unwrap_or_else(|e| panic!("[{OS}] DiskFs::new({}) failed: {e:?}", self.dir.display()))
+    }
+}
+
+impl Drop for Work {
+    fn drop(&mut self) {
+        let _ = fs::remove_dir_all(&self.dir);
+    }
+}
+
+fn os(e: &io::Error) -> String {
+    format!(
+        "kind {:?}, raw OS error {:?} ({e})",
+        e.kind(),
+        e.raw_os_error()
+    )
+}
+
+fn measured(case: &str, value: &str) {
+    println!("MEASURED: {case}: {OS}: {value}");
+}
+
+fn rp(s: &str) -> RelPath {
+    RelPath::new(s).unwrap_or_else(|e| panic!("[{OS}] RelPath::new({s:?}) rejected: {e:?}"))
+}
+
+/// Every entry below `dir` (`/`-joined relative names) with a description: `dir`, or the file's
+/// bytes. Read with `std::fs` from `read_dir` paths; used only for fixtures whose names the host
+/// stores without a special meaning.
+fn snapshot(dir: &Path) -> BTreeMap<String, String> {
+    fn walk(base: &Path, dir: &Path, out: &mut BTreeMap<String, String>) {
+        let entries = fs::read_dir(dir)
+            .unwrap_or_else(|e| panic!("[{OS}] snapshot: read_dir {}: {}", dir.display(), os(&e)));
+        for e in entries {
+            let p = e
+                .unwrap_or_else(|e| panic!("[{OS}] snapshot: entry: {}", os(&e)))
+                .path();
+            let rel = p
+                .strip_prefix(base)
+                .unwrap_or(&p)
+                .components()
+                .map(|c| c.as_os_str().to_string_lossy().into_owned())
+                .collect::<Vec<_>>()
+                .join("/");
+            let desc = match fs::symlink_metadata(&p) {
+                Ok(m) if m.is_dir() => {
+                    walk(base, &p, out);
+                    "dir".to_owned()
+                }
+                Ok(m) if m.is_file() => match fs::read(&p) {
+                    Ok(b) => format!("file {}", b.escape_ascii()),
+                    Err(e) => format!("unreadable file ({:?})", e.kind()),
+                },
+                Ok(_) => "other".to_owned(),
+                Err(e) => format!("no metadata ({:?})", e.kind()),
+            };
+            out.insert(rel, desc);
+        }
+    }
+    let mut out = BTreeMap::new();
+    walk(dir, dir, &mut out);
+    out
+}
+
+/// The names directly in `dir`, sorted.
+fn names(dir: &Path) -> Vec<String> {
+    let mut v: Vec<String> = fs::read_dir(dir)
+        .unwrap_or_else(|e| panic!("[{OS}] read_dir {}: {}", dir.display(), os(&e)))
+        .map(|e| {
+            e.unwrap_or_else(|e| panic!("[{OS}] read_dir entry: {}", os(&e)))
+                .file_name()
+                .to_string_lossy()
+                .into_owned()
+        })
+        .collect();
+    v.sort();
+    v
+}
+
+/// Record a mismatch instead of stopping, so one run shows every case.
+fn same<T: PartialEq + std::fmt::Debug>(problems: &mut Vec<String>, ctx: &str, got: T, want: T) {
+    if got != want {
+        problems.push(format!("[{OS}] {ctx}: expected {want:?}, got {got:?}"));
+    }
+}
+
+fn finish(test: &str, problems: Vec<String>) {
+    assert!(
+        problems.is_empty(),
+        "[{OS}] {test}: {} mismatch(es):\n{}",
+        problems.len(),
+        problems.join("\n")
+    );
+}
+
+/// A short label of a `Vfs` result, for messages and `MEASURED:` lines.
+fn label<T: std::fmt::Debug>(r: &Result<T, VfsError>) -> String {
+    match r {
+        Ok(v) => format!("Ok({v:?})"),
+        Err(VfsError::OutsideRoot { .. }) => "OutsideRoot".to_owned(),
+        Err(VfsError::NotFound { .. }) => "NotFound".to_owned(),
+        Err(VfsError::NotAFile { .. }) => "NotAFile".to_owned(),
+        Err(VfsError::Io { kind, .. }) => format!("Io({kind:?})"),
+    }
+}
+
+/// `true` when Interface (1) refuses `c` on this platform, besides the refusals every platform
+/// has (`\`, NUL).
+fn windows_refuses(c: char) -> bool {
+    WINDOWS_PUNCTUATION.contains(&c) || ('\u{1}'..='\u{1f}').contains(&c)
+}
+
+/// The naive model of Interface (1) for the name `a<c>b`: refused for `\` and NUL everywhere,
+/// and on Windows also for the set of (1).
+fn model_refuses(c: char) -> bool {
+    c == '\\' || c == '\0' || (RULE_ON && windows_refuses(c))
+}
+
+/// Run `cmd` with a timeout; `Ok(stdout)` on success, `Err` naming what failed and its output.
+fn run_output(mut cmd: Command, what: &str) -> Result<String, String> {
+    let mut child = cmd
+        .stdin(Stdio::null())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .map_err(|e| format!("{what}: spawn failed: {}", os(&e)))?;
+    let deadline = Instant::now() + SPAWN_TIMEOUT;
+    loop {
+        match child.try_wait() {
+            Ok(Some(_)) => break,
+            Ok(None) if Instant::now() < deadline => std::thread::sleep(Duration::from_millis(10)),
+            Ok(None) => {
+                let _ = child.kill();
+                let _ = child.wait();
+                return Err(format!("{what}: no exit within {SPAWN_TIMEOUT:?}; killed"));
+            }
+            Err(e) => return Err(format!("{what}: wait failed: {}", os(&e))),
+        }
+    }
+    let out = child
+        .wait_with_output()
+        .map_err(|e| format!("{what}: output: {}", os(&e)))?;
+    let stdout = String::from_utf8_lossy(&out.stdout).into_owned();
+    if out.status.success() {
+        Ok(stdout)
+    } else {
+        Err(format!(
+            "{what}: {} stdout {:?} stderr {:?}",
+            out.status,
+            stdout,
+            String::from_utf8_lossy(&out.stderr)
+        ))
+    }
+}
