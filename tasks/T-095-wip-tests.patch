+// ---------------------------------------------------------------------------------------------
+// Q-E (D-275): Windows' own answer for each refused character.
+
+/// Q-E: `std::fs::write` (not through Kiln) of a name `a<c>b` into its own directory of the
+/// fixture for each `c` of `<>:"|?*` and U+0001 to U+001F, one `MEASURED: qe U+XXXX: <platform>:
+/// fs::write "a<c>b": <result>; stored <names>` line each. On Windows only the bounded outcome is
+/// asserted: the call returns (`Ok` or `Err`) and nothing is written outside the character's
+/// directory. On Linux and macOS each write is `Ok` and stores the name as given with its bytes.
+#[test]
+fn windows_own_answer_for_each_refused_character() {
+    let w = Work::new("qe");
+    let mut problems = Vec::new();
+    let chars: Vec<char> = WINDOWS_PUNCTUATION
+        .into_iter()
+        .chain('\u{1}'..='\u{1f}')
+        .collect();
+    let mut dirs = Vec::new();
+    for c in chars {
+        let sub = format!("c{:04X}", c as u32);
+        w.file(&format!("{sub}/keep"), b"k");
+        dirs.push(sub.clone());
+        let name = format!("a{c}b");
+        let target = w.at(&sub).join(&name);
+        let result = fs::write(&target, b"q");
+        let mut stored = names(&w.at(&sub));
+        stored.retain(|n| n != "keep");
+        measured(
+            &format!("qe U+{:04X}", c as u32),
+            &format!(
+                "fs::write {name:?}: {}; stored {stored:?}",
+                match &result {
+                    Ok(()) => "Ok".to_owned(),
+                    Err(e) => format!("Err({})", os(e)),
+                }
+            ),
+        );
+        same(
+            &mut problems,
+            &format!("{sub}/keep"),
+            fs::read(w.at(&format!("{sub}/keep"))).map_err(|e| e.kind()),
+            Ok(b"k".to_vec()),
+        );
+        if !cfg!(windows) {
+            same(
+                &mut problems,
+                &format!("fs::write {name:?}"),
+                result.map_err(|e| e.kind()),
+                Ok(()),
+            );
+            same(
+                &mut problems,
+                &format!("stored for {name:?}"),
+                stored,
+                vec![name.clone()],
+            );
+            same(
+                &mut problems,
+                &format!("bytes of {name:?}"),
+                fs::read(&target).map_err(|e| e.kind()),
+                Ok(b"q".to_vec()),
+            );
+        }
+    }
+    dirs.sort();
+    same(&mut problems, "fixture top level", names(&w.dir), dirs);
+    finish("windows_own_answer_for_each_refused_character", problems);
+}
