+// ---------------------------------------------------------------------------------------------
+// Interface (1): the refused set, as an equality.
+
+/// AC-W1, Interface (5) first item: over U+0000 to U+00FF except `/`, one character at a time in
+/// a name `a<c>b`, `RelPath::new` refuses exactly the set of (1) plus `\` and NUL on Windows,
+/// and `\` and NUL alone on Linux and macOS; the six look-alikes are accepted everywhere. Every
+/// name the model accepts is stored as given: written, read and listed through `DiskFs` and
+/// `MemoryFs` under exactly that name, so on Linux and macOS the characters of (1) are ordinary.
+/// Each name is stored in its own directory `cXXXX/` (`aAb` and `aab` are one name on a volume
+/// that folds case).
+#[test]
+fn refused_set_is_exactly_interface_1_over_u0000_to_u00ff() {
+    let w = Work::new("equality");
+    let mut disk = w.disk();
+    let mut mem = MemoryFs::new();
+    let mut problems = Vec::new();
+    let mut refused = Vec::new();
+    let chars = (0u32..=0xff)
+        .filter_map(char::from_u32)
+        .filter(|&c| c != '/')
+        .chain(LOOK_ALIKES);
+    for c in chars {
+        let name = format!("a{c}b");
+        let want_refused = !LOOK_ALIKES.contains(&c) && model_refuses(c);
+        match RelPath::new(&name) {
+            Err(e) => {
+                refused.push(c);
+                if !want_refused {
+                    problems.push(format!(
+                        "[{OS}] RelPath::new({name:?}) (U+{:04X}) refused ({}), expected accepted",
+                        c as u32, e.reason
+                    ));
+                }
+                same(
+                    &mut problems,
+                    &format!("PathError.path of {name:?}"),
+                    e.path,
+                    name.clone(),
+                );
+            }
+            Ok(p) => {
+                same(
+                    &mut problems,
+                    &format!("as_str of {name:?}"),
+                    p.as_str(),
+                    name.as_str(),
+                );
+                if want_refused {
+                    problems.push(format!(
+                        "[{OS}] RelPath::new({name:?}) (U+{:04X}) accepted, expected refused",
+                        c as u32
+                    ));
+                }
+            }
+        }
+        // Only names the model accepts are stored: a name it refuses would, at base on Windows,
+        // only ask the file system for an error the mismatch above already reports.
+        if !want_refused {
+            let sub = format!("c{:04X}", c as u32);
+            fs::create_dir_all(w.at(&sub))
+                .unwrap_or_else(|e| panic!("[{OS}] fixture: create {sub}: {}", os(&e)));
+            let bytes = format!("bytes of U+{:04X}\n", c as u32).into_bytes();
+            let ok_bytes = label::<Vec<u8>>(&Ok(bytes.clone()));
+            let want_list: Result<Vec<String>, String> = Ok(vec![name.clone()]);
+            match RelPath::new(&format!("{sub}/{name}")) {
+                Ok(p) => {
+                    let wrote = disk.write_atomic(&p, &bytes);
+                    same(
+                        &mut problems,
+                        &format!("DiskFs write_atomic {p}"),
+                        label(&wrote),
+                        "Ok(())".to_owned(),
+                    );
+                    same(
+                        &mut problems,
+                        &format!("DiskFs read {p}"),
+                        label(&disk.read(&p)),
+                        ok_bytes.clone(),
+                    );
+                    let listed = disk
+                        .list_dir(Some(&rp(&sub)))
+                        .map(|l| l.entries.into_iter().map(|e| e.name).collect::<Vec<_>>())
+                        .map_err(|e| label::<()>(&Err(e)));
+                    same(
+                        &mut problems,
+                        &format!("DiskFs list_dir {sub}"),
+                        listed,
+                        want_list.clone(),
+                    );
+                    mem.insert(&p, &bytes);
+                    same(
+                        &mut problems,
+                        &format!("MemoryFs read {p}"),
+                        label(&mem.read(&p)),
+                        ok_bytes,
+                    );
+                    let listed = mem
+                        .list_dir(Some(&rp(&sub)))
+                        .map(|l| l.entries.into_iter().map(|e| e.name).collect::<Vec<_>>())
+                        .map_err(|e| label::<()>(&Err(e)));
+                    same(
+                        &mut problems,
+                        &format!("MemoryFs list_dir {sub}"),
+                        listed,
+                        want_list,
+                    );
+                }
+                Err(e) => problems.push(format!(
+                    "[{OS}] RelPath::new({sub}/{name:?}) refused: {e:?}"
+                )),
+            }
+        }
+    }
+    let mut want_refused: Vec<char> = (0u32..=0xff)
+        .filter_map(char::from_u32)
+        .filter(|&c| c != '/' && model_refuses(c))
+        .collect();
+    want_refused.sort_unstable();
+    refused.sort_unstable();
+    same(
+        &mut problems,
+        "count of refused characters",
+        refused.len(),
+        if RULE_ON { 2 + 7 + 31 } else { 2 },
+    );
+    same(&mut problems, "the refused set", refused, want_refused);
+    finish(
+        "refused_set_is_exactly_interface_1_over_u0000_to_u00ff",
+        problems,
+    );
+}
+
+/// The stream, drive and character forms of Interface (1) and AC-W1, as request paths.
+const FORMS: [&str; 15] = [
+    "f.txt:s",
+    "f.txt::$DATA",
+    "f.txt:s:$DATA",
+    "C:x",
+    "C:",
+    "D:x",
+    "x/C:y",
+    "x<y",
+    "gt>",
+    "q?",
+    "s*",
+    "p|q",
+    "dq\"",
+    "ctl\u{1}",
+    "ctl\u{1f}",
+];
+
+/// AC-W1, Interface (5) second item: every stream and drive form (and the characters AC-W1
+/// names) through `Document` open and save. On Windows each is refused by `RelPath::new`, the
+/// gate every request path passes (so `Document::open` and its save are never reached), and the
+/// fixture (`f.txt`, `x/y`) is unchanged: no file changed, no stream or drive was consulted. On
+/// Linux and macOS each is an ordinary name: a file planted under it opens, saves the edit under
+/// that name, and `f.txt` and `x/y` keep their bytes.
+#[test]
+fn stream_and_drive_forms_through_document_open_and_save() {
+    let w = Work::new("forms");
+    w.file("f.txt", b"f");
+    w.file("x/y", b"y");
+    let mut problems = Vec::new();
+    if RULE_ON {
+        let before = snapshot(&w.dir);
+        let mut disk = w.disk();
+        for form in FORMS {
+            match RelPath::new(form) {
+                Err(e) => same(
+                    &mut problems,
+                    &format!("PathError.path {form:?}"),
+                    e.path,
+                    form.to_owned(),
+                ),
+                Ok(p) => {
+                    let opened = Document::open(&disk, &p);
+                    let saved = match opened {
+                        Ok(mut doc) => format!(
+                            "{:?}",
+                            doc.save(&mut disk).map_err(|e| label::<()>(&Err(e)))
+                        ),
+                        Err(e) => format!("open {e:?}"),
+                    };
+                    problems.push(format!(
+                        "[{OS}] RelPath::new({form:?}) accepted, expected invalid_path; then {saved}"
+                    ));
+                }
+            }
+        }
+        same(
+            &mut problems,
+            "fixture after every form",
+            snapshot(&w.dir),
+            before,
+        );
+        same(
+            &mut problems,
+            "read f.txt",
+            label(&disk.read(&rp("f.txt"))),
+            label::<Vec<u8>>(&Ok(b"f".to_vec())),
+        );
+    } else {
+        for form in FORMS {
+            let planted = format!("planted {form:?}\n");
+            w.file(form, planted.as_bytes());
+            let p = rp(form);
+            let mut disk = w.disk();
+            match Document::open(&disk, &p) {
+                Ok(mut doc) => {
+                    same(
+                        &mut problems,
+                        &format!("Document::open({form:?}) text"),
+                        doc.buffer().text(),
+                        planted.clone(),
+                    );
+                    doc.buffer_mut()
+                        .insert(0, "EDIT ")
+                        .unwrap_or_else(|e| panic!("[{OS}] insert: {e:?}"));
+                    same(
+                        &mut problems,
+                        &format!("save {form:?}"),
+                        label(&doc.save(&mut disk).map(|_| ())),
+                        "Ok(())".to_owned(),
+                    );
+                    same(
+                        &mut problems,
+                        &format!("bytes of {form:?} after the save"),
+                        fs::read(w.at(form)).map_err(|e| e.kind()),
+                        Ok(format!("EDIT {planted}").into_bytes()),
+                    );
+                }
+                Err(e) => problems.push(format!("[{OS}] Document::open({form:?}): {e:?}")),
+            }
+            same(
+                &mut problems,
+                &format!("f.txt after {form:?}"),
+                fs::read(w.at("f.txt")).map_err(|e| e.kind()),
+                Ok(b"f".to_vec()),
+            );
+            same(
+                &mut problems,
+                &format!("x/y after {form:?}"),
+                fs::read(w.at("x/y")).map_err(|e| e.kind()),
+                Ok(b"y".to_vec()),
+            );
+        }
+    }
+    finish(
+        "stream_and_drive_forms_through_document_open_and_save",
+        problems,
+    );
+}
+
+// ---------------------------------------------------------------------------------------------
+// Interface (2): names Windows treats specially stay ordinary files.
+
+/// AC-W2, Interface (5) third item: `aux.rs`, `CON`, `a.` and `b ` are accepted by
+/// `RelPath::new` on every platform and, through `DiskFs`, written, read, listed (as given, none
+/// skipped) and saved by a `Document`, each holding its own bytes. Everything is read back through
+/// Kiln (`\\?\` paths on Windows), never through a plain host path, which on Windows names a
+/// device for `CON`.
+#[test]
+fn reserved_and_trailing_names_are_ordinary_files() {
+    const NAMES: [&str; 4] = ["aux.rs", "CON", "a.", "b "];
+    let w = Work::new("reserved");
+    let mut disk = w.disk();
+    let mut problems = Vec::new();
+    for name in NAMES {
+        match RelPath::new(name) {
+            Err(e) => problems.push(format!("[{OS}] RelPath::new({name:?}) refused: {e:?}")),
+            Ok(p) => {
+                let bytes = format!("first {name}\n").into_bytes();
+                same(
+                    &mut problems,
+                    &format!("write_atomic {name:?}"),
+                    label(&disk.write_atomic(&p, &bytes)),
+                    "Ok(())".to_owned(),
+                );
+                same(
+                    &mut problems,
+                    &format!("read {name:?}"),
+                    label(&disk.read(&p)),
+                    label::<Vec<u8>>(&Ok(bytes)),
+                );
+            }
+        }
+    }
+    match disk.list_dir(None) {
+        Ok(l) => {
+            let mut got: Vec<String> = l.entries.into_iter().map(|e| e.name).collect();
+            got.sort();
+            let mut want: Vec<String> = NAMES.iter().map(|s| (*s).to_owned()).collect();
+            want.sort();
+            same(&mut problems, "list_dir names", got, want);
+            same(&mut problems, "list_dir skipped", l.skipped, 0);
+        }
+        Err(e) => problems.push(format!("[{OS}] list_dir: {e:?}")),
+    }
+    same(
+        &mut problems,
+        "host names",
+        names(&w.dir).len(),
+        NAMES.len(),
+    );
+    for p in NAMES.iter().filter_map(|n| RelPath::new(n).ok()) {
+        let name = p.as_str();
+        match Document::open(&disk, &p) {
+            Ok(mut doc) => {
+                doc.buffer_mut()
+                    .insert(0, "saved ")
+                    .unwrap_or_else(|e| panic!("[{OS}] insert: {e:?}"));
+                same(
+                    &mut problems,
+                    &format!("Document save {name:?}"),
+                    label(&doc.save(&mut disk).map(|_| ())),
+                    "Ok(())".to_owned(),
+                );
+                same(
+                    &mut problems,
+                    &format!("read {name:?} after the save"),
+                    label(&disk.read(&p)),
+                    label::<Vec<u8>>(&Ok(format!("saved first {name}\n").into_bytes())),
+                );
+            }
+            Err(e) => problems.push(format!("[{OS}] Document::open({name:?}): {e:?}")),
+        }
+    }
+    same(
+        &mut problems,
+        "host names after the saves",
+        names(&w.dir).len(),
+        NAMES.len(),
+    );
+    finish("reserved_and_trailing_names_are_ordinary_files", problems);
+}
+
+// ---------------------------------------------------------------------------------------------
+// Interface (3): case and short names (measurement rule, Q-D).
+
+const LOWER: &[u8] = b"lower f\n";
+
+/// AC-W3, Interface (5) fourth item, first half: `F.TXT` against a file `f.txt`. Read: on macOS
+/// and Windows `Ok(<f.txt's bytes>)`, on Linux `NotFound`. Save: on macOS and Windows a
+/// `Document` opened as `F.TXT` saves over `f.txt`, leaving exactly one entry equal to `f.txt`
+/// ignoring ASCII case, holding the saved bytes, its spelling printed (`MEASURED: case spelling
+/// after save`), not asserted. On Linux `F.TXT` does not open (`NotFound`) and a save of it
+/// (`write_atomic`, what a save of a new file does) makes a second file: two entries, `F.TXT`
+/// new, `f.txt` unchanged.
+#[test]
+fn case_read_and_save_of_upper_name_against_lower_file() {
+    let w = Work::new("case");
+    w.file("f.txt", LOWER);
+    let mut disk = w.disk();
+    let upper = rp("F.TXT");
+    let mut problems = Vec::new();
+    let read = disk.read(&upper);
+    measured("case read F.TXT over f.txt", &label(&read));
+    let saved: Vec<u8> = if CASE_SENSITIVE {
+        same(
+            &mut problems,
+            "read F.TXT",
+            label(&read),
+            "NotFound".to_owned(),
+        );
+        match Document::open(&disk, &upper) {
+            Err(OpenError::Vfs(VfsError::NotFound { .. })) => {}
+            other => problems.push(format!(
+                "[{OS}] Document::open(F.TXT): expected NotFound, got {other:?}"
+            )),
+        }
+        let bytes = b"saved upper\n".to_vec();
+        same(
+            &mut problems,
+            "write_atomic F.TXT",
+            label(&disk.write_atomic(&upper, &bytes)),
+            "Ok(())".to_owned(),
+        );
+        bytes
+    } else {
+        same(
+            &mut problems,
+            "read F.TXT",
+            label(&read),
+            label::<Vec<u8>>(&Ok(LOWER.to_vec())),
+        );
+        match Document::open(&disk, &upper) {
+            Ok(mut doc) => {
+                same(
+                    &mut problems,
+                    "Document F.TXT text",
+                    doc.buffer().text(),
+                    String::from_utf8_lossy(LOWER).into_owned(),
+                );
+                doc.buffer_mut()
+                    .insert(0, "upper ")
+                    .unwrap_or_else(|e| panic!("[{OS}] insert: {e:?}"));
+                same(
+                    &mut problems,
+                    "save F.TXT",
+                    label(&doc.save(&mut disk).map(|_| ())),
+                    "Ok(())".to_owned(),
+                );
+            }
+            Err(e) => problems.push(format!("[{OS}] Document::open(F.TXT): {e:?}")),
+        }
+        format!("upper {}", String::from_utf8_lossy(LOWER)).into_bytes()
+    };
+    let entries = names(&w.dir);
+    measured("case spelling after save", &format!("{entries:?}"));
+    if CASE_SENSITIVE {
+        same(
+            &mut problems,
+            "entries",
+            entries,
+            vec!["F.TXT".to_owned(), "f.txt".to_owned()],
+        );
+        same(
+            &mut problems,
+            "f.txt bytes",
+            fs::read(w.at("f.txt")).map_err(|e| e.kind()),
+            Ok(LOWER.to_vec()),
+        );
+        same(
+            &mut problems,
+            "F.TXT bytes",
+            fs::read(w.at("F.TXT")).map_err(|e| e.kind()),
+            Ok(saved),
+        );
+    } else {
+        same(&mut problems, "entry count", entries.len(), 1);
+        match entries.first() {
+            Some(name) if name.eq_ignore_ascii_case("f.txt") => same(
+                &mut problems,
+                &format!("bytes of {name:?}"),
+                fs::read(w.dir.join(name)).map_err(|e| e.kind()),
+                Ok(saved),
+            ),
+            other => problems.push(format!(
+                "[{OS}] entry: expected f.txt in some case, got {other:?}"
+            )),
+        }
+    }
+    finish(
+        "case_read_and_save_of_upper_name_against_lower_file",
+        problems,
+    );
+}
