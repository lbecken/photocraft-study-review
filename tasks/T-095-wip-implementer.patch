From b32bf595bae2f10a751544c8e93c62907e2705fb Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 18 Nov 2026 22:02:47 +0000
Subject: [PATCH 2/3] kiln-cli: manifest_refusals_name_the_problem asserts the
 Windows refusal of a path with " (Interface (6))

Task: T-095
Role: implementer
---
 apps/kiln-cli/src/main.rs | 17 +++++++++--------
 1 file changed, 9 insertions(+), 8 deletions(-)

diff --git a/apps/kiln-cli/src/main.rs b/apps/kiln-cli/src/main.rs
index 844892f..54dc250 100644
--- a/apps/kiln-cli/src/main.rs
+++ b/apps/kiln-cli/src/main.rs
@@ -1209,14 +1209,15 @@ mod tests {
             assert!(got.contains("repeated in one object"), "{json}: {got}");
         }
         // The same key in different objects, and key-like strings in values, are fine.
-        assert_eq!(
-            parse_manifest(
-                br#"{"files":[{"path":"a","text":"\"path\":"},{"path":"b,{\"","hex":""}]}"#
-            )
-            .unwrap()
-            .len(),
-            2
-        );
+        let key_like = br#"{"files":[{"path":"a","text":"\"path\":"},{"path":"b,{\"","hex":""}]}"#;
+        if cfg!(windows) {
+            // On Windows `"` is refused in a path (T-095), so the second entry's path is invalid.
+            let got = parse_manifest(key_like).unwrap_err();
+            assert!(got.starts_with("files[1]: invalid relative path"), "{got}");
+            assert!(got.contains(&format!("{:?}", "b,{\"")), "{got}");
+        } else {
+            assert_eq!(parse_manifest(key_like).unwrap().len(), 2);
+        }
         // Keys are checked for every entry before any entry's path (Pinned (a)).
         let got = manifest_err(r#"{"files":[{"path":"/x","text":""},{"path":"a","oops":1}]}"#);
         assert!(got.starts_with("files[1]: unknown key"), "{got}");
-- 
