From a86a91df0de283db2b0f7678d04a69881137f29f Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 18 Nov 2026 22:01:59 +0000
Subject: [PATCH 1/3] kiln-workspace: on Windows RelPath::new refuses : < > " |
 ? * and U+0001-U+001F

The one #[cfg(windows)] statement of Interface (1) and the unit test
windows_name_characters of Interface (5).

Task: T-095
Role: implementer
---
 crates/kiln-workspace/src/path.rs | 72 ++++++++++++++++++++++++++++++-
 1 file changed, 71 insertions(+), 1 deletion(-)

diff --git a/crates/kiln-workspace/src/path.rs b/crates/kiln-workspace/src/path.rs
index 4b908f9..2343807 100644
--- a/crates/kiln-workspace/src/path.rs
+++ b/crates/kiln-workspace/src/path.rs
@@ -3,7 +3,9 @@
 use std::fmt;
 
 /// A validated path relative to a file-system root: non-empty, `/`-separated, no leading `/`,
-/// no empty, `.` or `..` segment, no `\` and no NUL. Display/as_str give it exactly as given.
+/// no empty, `.` or `..` segment, no `\` and no NUL; on Windows also none of `:`, `<`, `>`,
+/// `"`, `|`, `?`, `*` and no control character U+0001 to U+001F. Display/as_str give it exactly
+/// as given.
 #[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
 pub struct RelPath(String);
 
@@ -42,6 +44,15 @@ impl RelPath {
         if path.contains('\\') {
             return reject("path contains a backslash");
         }
+        #[cfg(windows)]
+        if path.contains(|c| {
+            matches!(
+                c,
+                ':' | '<' | '>' | '"' | '|' | '?' | '*' | '\u{1}'..='\u{1f}'
+            )
+        }) {
+            return reject("path contains a character Windows does not allow in a file name");
+        }
         if path.starts_with('/') {
             return reject("path starts with '/'");
         }
@@ -125,4 +136,63 @@ mod tests {
         assert_eq!(RelPath::new("x").unwrap().parent(), None);
         assert_eq!(RelPath::new("(root)").unwrap(), RelPath::root_placeholder());
     }
+
+    #[test]
+    fn windows_name_characters() {
+        let mut refused_on_windows: Vec<String> = [
+            "f.txt:s",
+            "f.txt::$DATA",
+            "f.txt:s:$DATA",
+            "C:x",
+            "C:",
+            "x/C:y",
+            "x<y",
+            "x>y",
+            "dq\"",
+            "p|q",
+            "q?",
+            "s*",
+        ]
+        .iter()
+        .map(|s| (*s).to_owned())
+        .collect();
+        refused_on_windows.extend(('\u{1}'..='\u{1f}').map(|c| format!("ctl{c}")));
+        for p in &refused_on_windows {
+            let r = RelPath::new(p);
+            if cfg!(windows) {
+                let err = r.unwrap_err();
+                assert_eq!(&err.path, p);
+                assert!(!err.reason.is_empty());
+            } else {
+                assert_eq!(r.unwrap().as_str(), p);
+            }
+        }
+        for p in [
+            "CON",
+            "PRN",
+            "AUX",
+            "NUL",
+            "COM1",
+            "COM9",
+            "COM\u{b9}",
+            "LPT1",
+            "LPT1.txt",
+            "CONIN$",
+            "aux.rs",
+            "con.txt",
+            "nul.rs",
+            "a.",
+            "b ",
+            "c. .",
+            "c~1.rs",
+            "x\u{7f}",
+            "\u{e9}",
+        ] {
+            assert_eq!(
+                RelPath::new(p).unwrap().as_str(),
+                p,
+                "{p:?} is accepted everywhere"
+            );
+        }
+    }
 }
-- 
