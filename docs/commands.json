      }
    },
    {
      "doc": "Redo the most recently undone step of a document.",
      "examples": [
        {
          "description": "redo an undone insert",
          "files": [
            [
              "a.txt",
              "x"
            ]
          ],
          "initial_text": "",
          "params": {
            "doc": 1
          },
          "result": {
            "dirty": true,
            "len_chars": 3,
            "redone": true
          },
          "setup": [
            [
              "doc.open",
              {
                "path": "a.txt"
              }
            ],
            [
              "doc.insert",
              {
                "doc": 1,
                "offset": 1,
                "text": "yz"
              }
            ],
            [
              "doc.undo",
              {
                "doc": 1
              }
            ]
          ]
        }
      ],
      "mutating": true,
      "name": "doc.redo",
      "params_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "description": "Params naming one open document.",
        "properties": {
          "doc": {
            "description": "Id of an open document.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "doc"
        ],
        "title": "DocParams",
        "type": "object"
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `doc.redo`.",
        "properties": {
          "dirty": {
            "description": "Whether the text now differs from the file's last opened or saved text.",
            "type": "boolean"
          },
          "len_chars": {
            "description": "Length in chars afterwards.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "redone": {
            "description": "True iff a step was redone (false: nothing to redo, nothing changed).",
            "type": "boolean"
          }
        },
        "required": [
          "redone",
          "len_chars",
          "dirty"
        ],
        "title": "RedoResult",
        "type": "object"
      }
    },
    {
      "doc": "Replace the chars `start..end` of a document with text, as one undo step, and return the removed text.",
      "examples": [
        {
          "description": "rename an identifier",
          "files": [
